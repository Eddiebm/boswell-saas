# App
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL is read as a fallback for AUTH_URL (older setups); set AUTH_URL instead.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Boswell engine / audits
OPENROUTER_API_KEY=
BOSWELL_ENGINE_GIT_URL=git+https://github.com/Eddiebm/boswell.git

# Worker
WORKER_SECRET=change-me
# Fine-grained token limited to Actions: Read and write on the Boswell worker
# repository. Without a working token a queued audit waits for GitHub's
# scheduled run, which can be hours away, and fails after 60 minutes. These
# tokens expire: set a reminder to renew it. Failures are reported to Sentry.
# (GITHUB_TOKEN is used if this is unset.)
GITHUB_WORKFLOW_TOKEN=
# Repository whose audit-worker.yml is dispatched (default Eddiebm/boswell-saas).
GITHUB_WORKER_REPO=

# Worker tuning (optional; the defaults are right for production)
# BOSWELL_DEPENDENCY_AUDIT=0        skip dependency audits
# BOSWELL_CHROMIUM_PATH=            use an existing Chromium for live smoke tests
# BOSWELL_AUDIT_MODE=standard       engine mode used by scripts/boswell-run-audit.py
# BOSWELL_MIN_AUDIT_CHARS=200       minimum engine output treated as a real audit

# Public contact address shown on /privacy and /terms
SUPPORT_EMAIL=

# Error monitoring (Sentry) — leave empty to disable
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload browser source maps at build time (readable stack traces). Set in Vercel.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Failure alerts (Resend). ADMIN_ALERT_EMAIL is also the only account allowed into /dashboard/admin.
ADMIN_ALERT_EMAIL=
RESEND_API_KEY=
ALERT_FROM_EMAIL=Boswell <onboarding@resend.dev>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Scripts only
# BASE_URL=            app URL for scripts/smoke-test-production.mjs
# OPENROUTER_NEW_KEY=  new key for scripts/setup-openrouter-key.mjs
